# agentctl environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# agentctl masks these values in all logs and `doctor` output.

# --- GPT-5.5 / OpenAI (Orchestrator brain) ---
# Only needed if you wire a real GPT-5.5 CLI/API adapter into .agent/config.json.
# The default config ships with command "CONFIGURE_ME" so the orchestrator
# falls back to the local Claude heuristic until you set this up.
OPENAI_API_KEY=

# Optional: custom base URL / org if you proxy GPT-5.5
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=

# --- Claude (Senior Builder) ---
# Claude Code CLI normally uses its own stored login (keychain/OAuth).
# Set this only if you want to drive `claude` via an API key instead.
ANTHROPIC_API_KEY=

# --- DeepSeek (cheap Worker, via OpenCode) ---
# OpenCode normally stores provider credentials itself (`opencode auth`).
# Set this only if your OpenCode setup reads DeepSeek from the environment.
DEEPSEEK_API_KEY=

# Optional: point agentctl's deepseek adapter at a running opencode server.
# OPENCODE_ATTACH_URL=http://localhost:4096
